        }
      ]
    },
    {
      "branch_id": 3,
      "text": "Fishermen avoid your questions. One finally speaks: the ledger appears whenever the sea demands settlement.",
      "responses": [
        {
          "response": "Ask who last held the ledger",
          "branch_file": "salt_ledger/salt_ledger_01.json",
          "branch_id": 5,
          "effects": { "energy": -5 }
        },
        {

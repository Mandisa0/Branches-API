          "branch_id": 2,
          "effects": { "energy": -5 }
        },
        {
          "response": "Consult the gathered lords",
          "branch_file": "throne_of_embers/throne_of_embers_01.json",
          "branch_id": 3,
          "effects": { "energy": -5 }
        },
        {
          "response": "Search the ruins beneath the hall",
          "branch_file": "throne_of_embers/throne_of_embers_01.json",
          "branch_id": 4,
          "effects": { "health": -5 }
        }
      ]
    },
    {
      "branch_id": 2,
      "text": "Heat bleeds through your armor. The embers shift, reacting to your presence. The throne is not empty — it is waiting.",
